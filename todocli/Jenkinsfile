pipeline {
    agent any

    // This tells Jenkins to use the Go tool you just configured
    tools {
        go 'go-latest'
    }

    environment {
        // Standard Go environment variables
        GO111MODULE = 'on'
        CGO_ENABLED = 0
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Fetching code from GitHub...'
                checkout scm
            }
        }
        
        stage('Format Check') {
            steps {
                echo 'Checking if code is formatted...'
                // Fails the build if code isn't formatted properly using gofmt
                sh 'test -z $(gofmt -l .)'
            }
        }

        stage('Test') {
            steps {
                // This tells Jenkins to change into the todocli folder
                dir('todocli') { 
                    echo 'Running unit tests...'
                    sh 'go test -v ./...'
                }
            }
        }
        
        stage('Build') {
            steps {
                // This tells Jenkins to change into the todocli folder
                dir('todocli') {
                    echo 'Building the application...'
                    sh 'go build -o todo_app'
                }
            }
        }
    }

    post {
        success {
            echo 'Go project built and tested successfully! '
        }
        failure {
            echo 'Oh no! The build or tests failed. '
        }
    }
}