pipeline {
    agent any

    tools {
        go 'go-latest'
    }

    environment {
        GO111MODULE = 'on'
        CGO_ENABLED = 0
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Fetching code from GitHub...'
                checkout scm
            }
        }
        
        stage('Format Check') {
            steps {
                echo 'Checking if code is formatted...'
                sh 'test -z $(gofmt -l .)'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                // Removed dir('todocli') wrapper
                sh 'go test -v ./...'
            }
        }
        
        stage('Build') {
            steps {
                echo 'Building the application...'
                // Removed dir('todocli') wrapper
                sh 'go build -o todo_app'
            }
        }
    }

    post {
        success {
            echo 'Go project built and tested successfully!'
        }
        failure {
            echo 'Oh no! The build or tests failed.'
        }
    }
}