pipeline {
    agent any

    tools {
        go 'go-latest'
    }

    environment {
        GO111MODULE = 'on'
        CGO_ENABLED = 0
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Fetching code from GitHub...'
                checkout scm
            }
        }
        
        stage('Format Check') {
            steps {
                echo 'Checking if code is formatted...'
                // Target the subdirectory where the Go code lives
                dir('todocli') {
                    sh 'test -z $(gofmt -l .)'
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                // Enter the directory containing the main module
                dir('todocli') {
                    sh 'go test -v ./...'
                }
            }
        }
        
        stage('Build') {
            steps {
                echo 'Building the application...'
                // Enter the directory containing the main module
                dir('todocli') {
                    sh 'go build -o todo_app'
                }
            }
        }
    }

    post {
        success {
            echo 'Go project built successfully! Saving the binary...'
            // Go back into your folder to grab the built file
            dir('todocli') {
                archiveArtifacts artifacts: 'todo_app', onlyIfSuccessful: true
            }
        }
        failure {
            echo 'The build or tests failed. '
        }
    }
}